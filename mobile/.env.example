# The SIGMA API this build talks to.
#
# Copy this file to `.env` and adjust. Anything prefixed with EXPO_PUBLIC_ is
# inlined into the app bundle at build time, so never put a secret here.
#
# The address can also be changed at runtime in the app's Settings screen;
# this value is only the default that ships with the build.
#
# Android emulator: 10.0.2.2 is the host machine's loopback interface.
# Physical device:  use the host's LAN address, e.g. http://192.168.1.20:3000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
