# Expo / React Native build artefacts and local state.
node_modules/
.expo/
.expo-shared/
.expo-export-check/
dist/
web-build/
*.log

# Native projects are generated by prebuild and are not committed.
android/
ios/

# Signing material. EAS keeps the upload keystore in its own credentials
# store; a keystore that ever lands in the repository is a leaked key.
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
