# Copy to .env.local and fill in what you need. Never commit .env.local.
# Every variable is optional: without any of them the app runs on the
# committed fixtures, the Policy Copilot refuses requests with
# `not_configured`, and the maps fall back to OpenStreetMap raster tiles.

# --- Policy Copilot (POST /api/v1/chat) — server-side only ---
# Groq API key. Read on the server, never sent to the browser.
GROQ_API_KEY=
# Optional model override. Defaults to openai/gpt-oss-20b.
GROQ_MODEL=
# Set either to "true" to switch the copilot off (it answers not_configured).
CHAT_DISABLED=
CHAT_PUBLIC_DISABLED=

# --- Basemap (public; NEXT_PUBLIC_* is inlined into the browser bundle) ---
# Precedence: NEXT_PUBLIC_MAP_STYLE_URL, then NEXT_PUBLIC_MAPTILER_KEY, then OSM.
# Any MapLibre style URL.
NEXT_PUBLIC_MAP_STYLE_URL=
# MapTiler Cloud key (vector style + terrain). Use a domain-restricted key.
NEXT_PUBLIC_MAPTILER_KEY=
# MapTiler style id. Defaults to "dataviz".
NEXT_PUBLIC_MAPTILER_STYLE=
